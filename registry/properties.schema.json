{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/D-sorganization/public-web-management/blob/main/registry/properties.schema.json",
  "title": "D-sorganization public web property registry",
  "type": "object",
  "required": ["properties"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/property" }
    }
  },
  "$defs": {
    "property": {
      "type": "object",
      "required": [
        "name",
        "display_name",
        "kind",
        "source",
        "public_url",
        "deploy",
        "sync_procedure",
        "owner_repo"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable slug used to reference the property in issues and docs."
        },
        "display_name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["pages-site", "pages-mirror"],
          "description": "pages-site: the public repo is the canonical source. pages-mirror: canonical source lives elsewhere and is synced into a public mirror repo."
        },
        "source": {
          "type": "object",
          "required": ["repo", "path"],
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string",
              "pattern": "^[^/]+/[^/]+$",
              "description": "Canonical source repo, owner/name."
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Path of the canonical source within the repo ('/' for repo root)."
            }
          }
        },
        "public_url": {
          "type": "string",
          "pattern": "^https://",
          "description": "Live URL of the deployed property."
        },
        "deploy": {
          "type": "object",
          "required": ["mechanism", "workflow", "pages_build_type", "custom_domain"],
          "additionalProperties": false,
          "properties": {
            "mechanism": { "type": "string", "enum": ["github-actions"] },
            "workflow": {
              "type": "string",
              "description": "Path of the deploy workflow within the deploying repo."
            },
            "pages_build_type": { "type": "string", "enum": ["workflow", "legacy"] },
            "custom_domain": { "type": ["string", "null"] }
          }
        },
        "sync_procedure": {
          "type": "string",
          "minLength": 1,
          "description": "How content moves from canonical source to the deployed site. For pages-site, state that no sync is needed."
        },
        "owner_repo": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$",
          "description": "Repo where issues about the property itself belong."
        },
        "notes": { "type": "string" }
      }
    }
  }
}
